# Environment & secrets
.env
.env.*
!.env.example
*.pem
*_credentials*
/secrets/

# Books & runtime data (never commit books or models)
*.epub
*.gguf
*.safetensors
/runtime/
/data/

# Root-level logs / caches / tmp
/logs/
/cache/
/tmp/
*.log

# Dependencies (per-app .gitignore also applies)
node_modules/
vendor/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local DB dumps
*.dump
*.sql.gz

# IDE / OS metadata
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
