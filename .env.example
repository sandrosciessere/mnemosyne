# Mnemosyne stack environment — copy to .env, fill in secrets, chmod 600.
# The real .env must NEVER be committed.

APP_NAME=Mnemosyne
APP_ENV=production
# Generate with: cd apps/web && php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://mnemosyne.shellrent.com
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Dedicated containerized PostgreSQL (never the host instance on :5433)
DB_CONNECTION=pgsql
DB_HOST=pg
DB_PORT=5432
DB_DATABASE=mnemosyne
DB_USERNAME=mnemosyne
DB_PASSWORD=change-me-strong-password

# Dedicated containerized Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# No mail service configured yet: password reset mails go to the log
MAIL_MAILER=log

# Persistent data tree on the host, bind-mounted at /data in containers
MNEMOSYNE_DATA_ROOT=/srv/data/mnemosyne
MNEMOSYNE_DATA_PATH=/data

# Host Ollama (optional dependency, reached through the Docker host gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI worker
WORKER_READINESS_CHECKS=db,redis,storage
WORKER_DATA_PATH=/data

# Loopback port published on the host for the host nginx reverse proxy
MNEMOSYNE_HTTP_PORT=8100
