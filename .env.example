# Mnemosyne stack environment — copy to .env, fill in secrets, chmod 600.
# The real .env must NEVER be committed.

APP_NAME=Mnemosyne
APP_ENV=production
# Generate with: cd apps/web && php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://mnemosyne.shellrent.com
APP_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Dedicated containerized PostgreSQL (never the host instance on :5433)
DB_CONNECTION=pgsql
DB_HOST=pg
DB_PORT=5432
DB_DATABASE=mnemosyne
DB_USERNAME=mnemosyne
DB_PASSWORD=change-me-strong-password

# Dedicated containerized Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# No mail service configured yet: password reset mails go to the log
MAIL_MAILER=log

# Persistent data tree on the host, bind-mounted at /data in containers
MNEMOSYNE_DATA_ROOT=/srv/data/mnemosyne
MNEMOSYNE_DATA_PATH=/data

# Host Ollama (optional dependency, reached through the Docker host gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# AI worker
WORKER_READINESS_CHECKS=db,redis,storage
WORKER_DATA_PATH=/data

# Internal service-to-service token (Laravel -> ai-worker). REQUIRED for
# the ingestion pipeline. Generate with: openssl rand -hex 32
MNEMOSYNE_INTERNAL_TOKEN=
MNEMOSYNE_WORKER_BASE_URL=http://ai-worker:8000

# EPUB ingestion pipeline (conservative defaults for the shared host).
# Concurrency also drives the Horizon supervisor-ingestion process count.
MNEMOSYNE_INGESTION_CONCURRENCY=2
MNEMOSYNE_MAX_UPLOAD_BYTES=150000000
MNEMOSYNE_INGESTION_STALE_MINUTES=30
MNEMOSYNE_SUBMISSIONS_PER_HOUR=30
# Allowlisted roots for mnemosyne:library:discover, "name=path" pairs
# separated by commas. Empty until the real library mount exists.
MNEMOSYNE_IMPORT_SOURCES=

# Worker EPUB safety limits (bytes / counts / ratio) — see
# services/ai-worker/README.md for the full list and defaults.
#WORKER_MAX_EPUB_COMPRESSED_BYTES=200000000
#WORKER_MAX_EPUB_UNCOMPRESSED_BYTES=1000000000
#WORKER_MAX_ZIP_ENTRIES=10000
#WORKER_MAX_COMPRESSION_RATIO=200

# Loopback port published on the host for the host nginx reverse proxy
MNEMOSYNE_HTTP_PORT=8100
